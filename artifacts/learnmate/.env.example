# ─── LearnMate Environment Variables ──────────────────────────────────────────
#
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES.
# NEVER commit .env to version control.

# Clerk Authentication
# Get your Publishable Key from: https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: use a proxy URL for Clerk in development (e.g., https://YOUR_PROXY.dev.clerk.accounts.dev)
# VITE_CLERK_PROXY_URL=

# ─── Local Development ─────────────────────────────────────────────────────────
# For local runs, set BASE_PATH=/ and PORT=3000 (or your preferred port):
#   BASE_PATH=/ PORT=3000 pnpm dev
#
# Or copy to .env and use pnpm dev directly:
#   BASE_PATH=/
#   PORT=3000
BASE_PATH=/
PORT=3000
