{
  "expo": {
    "name": "LearnMate AI",
    "slug": "learnmate-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "learnmate",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#080F1E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.learnmate.ai"
    },
    "android": {
      "package": "com.learnmate.ai",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#080F1E"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://learnmate-web.netlify.app"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "fafa27f0-7c5c-4408-b9e7-71406e5b154a"
      }
    },
    "owner": "isabalearnmateai"
  }
}
